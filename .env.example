# 必填：Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 必填：Web 工作台访问密码（部署在公网 VPS 时防止未授权访问）
STUDIO_PASSWORD=change_me_to_strong_password

# 看板服务端口（默认使用非高频端口 28828，可自行按需修改）
PORT=28828

# 你的 X 账号 Handle（用于自动生成的暗黑卡片右下角水印）
X_HANDLE=@YourTechCapitalHandle

# 后台自动巡航扫描间隔（单位：分钟）
SCAN_INTERVAL_MINUTES=30

# 【海外 VPS 防 Reddit 403 封禁方案二选一（本地开发运行可全部留空）】
# 方案 A：填写一行 HTTP/Socks5 住宅代理 URL（推荐，省心稳定）
REDDIT_PROXY_URL=

# 方案 B：在 https://www.reddit.com/prefs/apps 免费创建 script 类型应用填入凭据
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
