# 必填：Google Gemini API Key（免费申请: https://aistudio.google.com/）
GEMINI_API_KEY=your_gemini_api_key_here

# 必填：Web 工作台访问密码（部署在公网 VPS 时防止未授权访问）
STUDIO_PASSWORD=change_me_to_strong_password

# 安全选项：若通过 HTTPS 反向代理访问，建议设为 1（仅在 HTTPS 传输会话 Cookie）
COOKIE_SECURE=0

# 看板服务端口（默认使用非高频端口 28828，可自行按需修改）
PORT=28828

# 你的 X 账号 Handle（用于自动生成的数据卡片右下角水印）
X_HANDLE=@YourTechCapitalHandle

# 后台自动巡航扫描间隔（单位：分钟）
SCAN_INTERVAL_MINUTES=30

# ==========================================
# 【Telegram 机器人与广播频道配置（可选）】
# ==========================================
# 1. 必填（开启 TG）：在 Telegram 联系 @BotFather 创建 Bot 获取 Token
TELEGRAM_BOT_TOKEN=

# 2. 必填（开启 TG）：你的个人 Telegram 用户数字 ID（严格鉴权防越权，可联系 @userinfobot 获取）
TELEGRAM_ADMIN_CHAT_ID=

# 3. 选填：公开广播频道 Username 或 ID（如 @YourAlphaChannel，用于标记发布时自动同步）
TELEGRAM_CHANNEL_ID=

# 4. 开关控制
# 捕获高信噪比线索时自动推送到手机私聊（1: 开启, 0: 关闭）
TELEGRAM_NOTIFY_ON_CAPTURE=1
# 在工作台或手机点击「已发布」后自动将图文广播至频道（1: 开启, 0: 关闭）
TELEGRAM_BROADCAST_ON_PUBLISH=1

# 5. 若在本地无代理环境运行且无法直连 api.telegram.org，可填 HTTP/SOCKS5 代理（海外 VPS 留空）
TELEGRAM_PROXY_URL=

# 【社区情报采集说明】
# 1. GitHub Trending 与 Hacker News (YC)：100% 官方公开 API，海外 VPS 零门槛直接抓取，无需任何配置！
# 2. Reddit（海外 VPS 机房 IP 被 Reddit 官方 Cloudflare 拦截）：
#    - 方案 1：配置住宅代理或本地代理（推荐）
REDDIT_PROXY_URL=
#    - 方案 2：或者从电脑浏览器复制已登录 Reddit 的 Cookie（绕过机器人风控）
REDDIT_COOKIE=
